// A quick look up to test for ArchiMate Event types
const EVENT_TYPES = new Set( [ARCHI_BIZ_EVENT, ARCHI_APP_EVENT, ARCHI_TECH_EVENT, ARCHI_IMPL_EVENT] );

// A Stakeholder must be a Stakeholder or an active Business Structure element
const RACI_STAKEHOLDERS = new Set( [ARCHI_STAKEHOLDER, ARCHI_ACTOR, ARCHI_ROLE, ARCHI_COLLABORATION] );

function isStakeholder( e ) {
	return RACI_STAKEHOLDERS.has( e.type );
}

