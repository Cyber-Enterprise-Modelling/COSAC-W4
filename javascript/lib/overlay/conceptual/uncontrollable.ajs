/*
 * A Helper class for an Uncontrollable Event used in Dependency Modelling
 * Cyber Enterprise Modelling 2025
 */

class Uncontrollable extends DependencyModel {
	static eventCatalogue = new TypedMap( String, Uncontrollable ); // Avoids creating same Uncontrollable Event more than once!
	static currentState = new Map(); // Holds current state of all Uncontrollables.

	// Test whether an element is a valid SABSA Uncontrollable.
	// i.e. modelled as an Event with a 'stereotype' property value from SABSA namespace set to 'Uncontrollable'.
	static isUncontrollable( e ) {
		let result = false;
		if ( EVENT_TYPES.has( e.type ) && e.prop( PROP_NAMESPACE ) && ( e.prop( PROP_NAMESPACE ) === SABSA ) ) {
			if ( e.prop( PROP_STEREOTYPE ) && ( e.prop( PROP_STEREOTYPE ) === ST_UNCONTROLLABLE ) ) { result = e.prop( PROP_STEREOTYPE ); } // true
		}
		else if( e.type ) { console.log( e.name, '(', e.type, ") cannot be interpreted as an Uncontrollable." ); }
		else console.error("Trying to process " + e.name + " as an Uncontrollable." );
		return result;
	};

	constructor( v ) {
		let e = v.concept;;
		if( EVENT_TYPES.has( e.type ) ) {
			if( Uncontrollable.eventCatalogue.has( e.id ) ) { return Uncontrollable.eventCatalogue.get( e.id ); }
			else {
				super( v, ST_UNCONTROLLABLE );
				Uncontrollable.eventCatalogue.set( e.id, this );
				this.setOutSignals();
			}
		}
	}

	// Trace all outbound signals forward to termination in a Paragon.
	getDependentParagons() { return this.getDependents( ST_PARAGON ); }

	/*// Terminate the tree with an Uncontrollable.
	getTree() {
		let json = new Object();
		json.name = this.#element.name;
		json.stereotype = this.#stereotype;
		json.refCode = this.#element.prop( PROP_REFCODE );

		return json;
	}
	//*/

	// Navigates from all Uncontrollable Visual Elements to collect visual Notes
	getNotes( matchType ) {
		let notes = new Set();
		this.getVizElements().forEach( v => {
			$(v).inRels( ARCHI_DIAG_CONNECTION ).each( function( c ) {
				if( c.source.type === ARCHI_DIAG_NOTE ) {
					let note = c.source;
					if ( note.prop( PROP_STEREOTYPE ) == matchType ) { notes.add( note ); }
				}
			});
		});
		return notes;
	}

	// Set the Uncontrollable into a random state based on pTable threshold
	// Skip the randomisation if this Uncontrollable is being held fixed (Context.currentFocus is defined and matches the current #id. )
	setRandom() {
		if( Context.currentFocus && this.getID() == Context.currentFocus.getID() ) { return; }
		else {
			let t = this.getSuccessThreshold();
			let randomScore = Context.getFreshRandom(); // returns a random value 0<= r <=1
			let state = randomScore > t;
			super.setStatus( state );
			Uncontrollable.currentState.set( this.getName(), state );

			( state ) ? console.setTextColor(0, 128, 0) : console.setTextColor(255, 0, 0);
			console.log( 'Randomising', this.getName(), 'Comparing:', randomScore.toFixed(3), 'against pTable Threshold:', t, state ? ': SUCCEED' : ': FAIL' );
			console.setDefaultTextColor();
		}
	}

	// Forces the Uncontrollable into a temporary state in order to visualise the consequences
	forceStatus( state ) { super.setStatus( state ); }
}