// ***************************************************************************

function setFocusEvent( ) {
	let set= new Set(), focusEvent = null;
	$(selection).filter( 'element' ).forEach( function( v ) {
		if( EVENT_TYPES.has( v.type ) ) {
			focusEvent = new Uncontrollable( v );
			set.add( focusEvent );
		}
		Context.CurrentView = v.view;
	});
	if( set.size == 1 ) { return Context.currentFocus = focusEvent; }
	else {
		window.alert( set.size < 1 ? "No Event selected." : "Multiple Events selected." );
		exit();
	}
}

function getVariableEvents( fixedEvent ) {
	let set = new Set();
	// Find all the other events in the View
	$(Context.CurrentView).find().filter( 'element' ).forEach( function( v ) {
		if( EVENT_TYPES.has( v.type ) ) { set.add( new Uncontrollable( v ) ); }
	});
	return set;
}

function calibrateSensitivity( event, state, uncontrollables ) {
	Context.currentForceStatus = state;

	let stateDescriptor = state ? 'Succeed' : 'Fail';
	( stateDescriptor ) ? console.setTextColor(255, 0, 0) : console.setTextColor(0, 128, 0);
	console.log( "\nForcing", event.getName(), 'to', stateDescriptor );
	console.setDefaultTextColor();

	for( let i=0; i<trialCount; i++ ) {
		event.forceStatus( state );
		uncontrollables.forEach( u => { u.setRandom(); });
		console.log( "\nStart Evaluation of Paragons:\n" );
		paragons.forEach( p => { p.evaluate(); });

		if( Context.stepMode ) {
			if( !window.confirm( event.getName() + " set to: " + stateDescriptor + " - Trial: " + `${i+1}` + ".\nOK to Continue:" ) ) {
				uncontrollables.forEach( u => { u.resetStatus(); });
				exit();
			}
		}
		uncontrollables.forEach( u => { u.resetStatus(); });
		console.clear();
	}
}

// ***************************************************************************
console.show();
console.clear();

let trialCount=promptTrials();
DependencyModel.setMode( DependencyModel.DYNAMIC_MODE );

Context.stepMode = promptStepMode();

// let target = selectParagon();
let fixedEvent = setFocusEvent();
let paragons = fixedEvent.getDependentParagons();

console.clear();
console.log( '\nRecalibrate the Sensitivity to', fixedEvent.getName(), ':\n - held fixed for', trialCount, 'trials in FAIL state and then in SUCCEED:');

Context.mode = Context.SENSITIVITY;
Context.trace = false;

let uncontrollables = getVariableEvents( fixedEvent );
console.log( "Analysing sensitivity of", [ ...paragons ].map( x => x.getName() ).join() );

calibrateSensitivity( fixedEvent, DependencyModel.bFAIL, uncontrollables );
paragons.forEach( p => { p.resetTally(); } );
calibrateSensitivity( fixedEvent, DependencyModel.bSUCCEED, uncontrollables );

console.log("\nDone");