const percent = (count, total) => { return Math.round( parseInt(count)*100 / parseInt(total) ) };

const SEP = detectOS();
load( __SCRIPTS_DIR__ + "lib" + SEP + "utils" + SEP + "archimate.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "utils" + SEP + "sabsa.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "utils" + SEP + "typedMap.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "lib" + SEP + "dependencyModel.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "paragon.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "dependency.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "qDependency.ajs");
