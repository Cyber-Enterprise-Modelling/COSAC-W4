function detectOS() {
	winCount = __SCRIPTS_DIR__.split("\\").length - 1;
	macCount = __SCRIPTS_DIR__.split("\/").length - 1;
	console.log("Directory separator", __SCRIPTS_DIR__, winCount, macCount);
	return (winCount > macCount) ? "\\" : "\/";
}
const SEP = detectOS();

load( __SCRIPTS_DIR__ + "lib" + SEP + "utils" + SEP + "archimate.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "utils" + SEP + "sabsa.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "utils" + SEP + "typedMap.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "lib" + SEP + "dependencyModel.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "paragon.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "dependency.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "uncontrollable.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "conceptual" + SEP + "qDependency.ajs");

load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "relationship" + SEP + "bayesianJunction.ajs");
load( __SCRIPTS_DIR__ + "lib" + SEP + "overlay" + SEP + "relationship" + SEP + "qJunction.ajs");

function selectParagon( ) {
	let set= new Set(), target = null;
	$(selection).filter( ARCHI_GOAL ).forEach( function( v ) {
		if( Paragon.isParagon( v ) ) {
			target = new Paragon( v );
			set.add( target );
		}
		Context.CurrentView = v.view;
	});
	if( set.size == 1 ) { return Context.currentFocus = target; }
	else {
		window.alert( set.size < 1 ? "No Goal selected." : "Multiple Goals selected." );
		exit();
	}
}

function selectDependencies( ) {
	let set= new Set(), target = null;
	$( Context.CurrentView ).find().filter( ARCHI_OUTCOME ).forEach( function( v ) {
		if( Dependency.isDependency( v ) ) {
			target = new Dependency( v );
			set.add( target );
		}
	});
	return set;
}


function selectUncontrollables( ) {
	let set= new Set(), target = null;
	$( Context.CurrentView ).find().filter( ARCHI_BIZ_EVENT ).forEach( function( v ) {
		if( Uncontrollable.isUncontrollable( v ) ) {
			target = new Uncontrollable( v );
			set.add( target );
		}
	});
	return set;
}


// ***************************************************************************

console.show();
console.clear();
console.log( "Export the Dependency Model state as 2 JSON objects" );

let modelValidator = new Validator();

// Select the Paragon as the root of the export:
let paragon = selectParagon( );
console.log( "\nGenerating Probability Table for", paragon.getName(), ':' );

let elements = new Array();
elements.push( paragon.getJSON() );

let dependencies = selectDependencies();
for( let d of dependencies ) {
	elements.push( d.getJSON() );
}

let uncontrollables = selectUncontrollables();
for( let u of uncontrollables ) {
	elements.push( u.getJSON() );
}
console.log( JSON.stringify( elements ) );

console.log( "\nGenerating Structural Tree for", paragon.getName(), ':' );
let tree = paragon.getTree();
console.log( JSON.stringify( tree ) );

console.log("Done");