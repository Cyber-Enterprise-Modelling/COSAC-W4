    </element>
    <element xsi:type="archimate:BusinessEvent" name="No Malformed Network Time Signal" id="id-8598f18336a04b52a08950902bd10d20">
      <documentation>NTP half (moves to &quot;High&quot; — UDP source-spoofing bypasses NAT without needing to breach the LAN boundary at all).</documentation>
      <property key="namespace" value="SABSA"/>
      <property key="stereotype" value="Uncontrollable"/>
      <property key="refCode" value="idUNC.08"/>
      <property key="pTable" value="{&quot;fail&quot;: 0.04, &quot;success&quot;: 0.96}"/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Home Router Effectiveness" id="id-2d910e532a5844f6b4a8c0dc45867b14">
      <documentation>Consumer router NAT/firewall genuinely blocks one thing well: unsolicited inbound connections from the WAN.&#xD;
&#xD;
 It is however highly ineffective at blockin:&#xD;
•	Outbound-initiated connections the STB makes itself (irrelevant to Chain A regardless of router quality).&#xD;
•	On-path position achieved via a compromised router — itself frequently the least-patched device on the network, and once compromised, it is on-path against every packet in the home with zero additional attacker effort.&#xD;
•	On-path position achieved via any other compromised LAN device (IoT gadget, guest device), since almost no consumer router enables client/AP isolation by default — the home network is flat.&#xD;
•	UDP source-spoofing/path-injection against long-lived flows (NTP), which doesn't require breaching the NAT boundary at all.&#xD;
•	IPv6, where many routers pass through a materially weaker default firewall policy than their well-tested IPv4 NAT path.&#xD;
</documentation>
      <property key="namespace" value="SABSA"/>
      <property key="stereotype" value="Uncontrollable"/>
      <property key="refCode" value="idUNC.07"/>
      <property key="pTable" value="{&quot;fail&quot;: 0.01, &quot;success&quot;: 0.99}"/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="No Stack Overflow Attack" id="id-86c43c66d8984c488e14aa22d8f0a113">
      <property key="namespace" value="SABSA"/>
      <property key="stereotype" value="Uncontrollable"/>
      <property key="refCode" value="idUNC.06"/>
      <property key="pTable" value="{&quot;fail&quot;: 0.75, &quot;success&quot;: 0.35}"/>
    </element>
  </folder>
  <folder name="Application" id="id-e0e581897f0b49b889ff3c55c96c7c81" type="application"/>
